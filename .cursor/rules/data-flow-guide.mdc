## Frontend: Page Component

### Server Component (`page.tsx`)

```typescript
import { Suspense } from 'react'
import { redirect } from 'next/navigation'
import { authServerClient } from '@/lib/auth/auth-server-client'
import { Navigation } from '@/components/navigation'
import { UsersDataTable, TableSkeleton } from './client'

// PPR automatically enabled with cacheComponents: true
export default async function DashboardPage() {
  // 1. Authenticate user (if needed)
  const { data, error } = await authServerClient.getSession()
  if (!data || error) {
    redirect('/login')
  }

  return (
    <div className="min-h-screen">
      {/* STATIC SHELL - Pre-rendered at build time */}
      <nav className="bg-white shadow">
        <Navigation />
      </nav>

      <main className="container mx-auto py-8">
        {/* STATIC HEADER */}
        <header className="mb-8">
          <h1 className="text-3xl font-bold">Dashboard</h1>
          <p className="text-gray-600">Welcome back!</p>
        </header>

        {/* DYNAMIC SECTIONS - Each wrapped in Suspense */}
        <div className="space-y-8">
          <Suspense fallback={<TableSkeleton />}>
            <UsersDataTable />
          </Suspense>
        </div>
      </main>
    </div>
  )
}
```

### Client Component (`client.tsx`)

```typescript
'use client'

import { useQuery } from '@tanstack/react-query'
import { useState, useTransition } from 'react'
import { authApiClient } from '@/lib/api'

export function UsersDataTable() {
  const [filters, setFilters] = useState({ 
    page: 1, 
    status: 'active' 
  })
  const [isPending, startTransition] = useTransition()

  // Data fetches on client when component mounts
  const { data, error } = useQuery({
    queryKey: ['users', filters],
    queryFn: async () => {
      const { data, error } = await authApiClient.users.list.get({
        query: filters,
      })
      if (error) throw error
      return data
    },
    staleTime: 2 * 60 * 1000, // 2 minutes
    placeholderData: (prev) => prev, // Keep old data while fetching
  })

  const updateFilters = (updates: Partial<typeof filters>) => {
    // Prevents Suspense fallback from showing
    startTransition(() => {
      setFilters((prev) => ({ ...prev, ...updates }))
    })
  }

  if (error) throw error // Error boundary handles this

  return (
    <div className="bg-white rounded-lg shadow">
      {isPending && (
        <div className="absolute top-4 right-4">
          <Spinner />
        </div>
      )}

      <DataTableFilters 
        filters={filters} 
        onFilterChange={updateFilters} 
      />
      <DataTable data={data.users} columns={columns} />
      <DataTablePagination
        page={filters.page}
        total={data.total}
        onPageChange={(page) => updateFilters({ page })}
      />
    </div>
  )
}

export function TableSkeleton() {
  return (
    <div className="bg-white rounded-lg shadow p-6">
      <div className="animate-pulse space-y-4">
        <div className="h-10 bg-gray-200 rounded w-1/4" />
        <div className="space-y-3">
          {[...Array(5)].map((_, i) => (
            <div key={i} className="h-12 bg-gray-100 rounded" />
          ))}
        </div>
      </div>
    </div>
  )
}
```

