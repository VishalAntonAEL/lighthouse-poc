## Best Practices

### ✅ DO: Use Granular Suspense Boundaries

```typescript
// Each section streams independently
<Suspense fallback={<MetricsSkeleton />}>
  <MetricsCards />
</Suspense>

<Suspense fallback={<TableSkeleton />}>
  <UsersTable />
</Suspense>
```

### ✅ DO: Use useTransition for Filter Updates

```typescript
const [isPending, startTransition] = useTransition()

const handleFilterChange = (newFilter: string) => {
  // Prevents Suspense fallback from showing
  startTransition(() => {
    setFilter(newFilter)
  })
}
```

### ✅ DO: Use Query Keys Factory Pattern

```typescript
// Invalidate all user queries
queryClient.invalidateQueries({ queryKey: userKeys.all })

// Invalidate only lists
queryClient.invalidateQueries({ queryKey: userKeys.lists() })

// Invalidate specific user
queryClient.invalidateQueries({ queryKey: userKeys.detail(userId) })
```

### ✅ DO: Use placeholderData for Smooth Transitions

```typescript
const { data } = useQuery({
  queryKey: ['users', page],
  queryFn: fetchUsers,
  placeholderData: (prev) => prev, // Keep old data while fetching
})
```

### ✅ DO: Handle Errors with Error Boundaries

```typescript
// app/error.tsx
'use client'

export default function Error({
  error,
  reset,
}: {
  error: Error & { digest?: string }
  reset: () => void
}) {
  return (
    <div className="p-4">
      <h2>Something went wrong!</h2>
      <p>{error.message}</p>
      <button onClick={reset}>Try again</button>
    </div>
  )
}
```

### ❌ DON'T: Mix Server Rendering with Client Data

```typescript
// ❌ BAD - Can cause hydration mismatches
export default async function Page() {
  const data = await fetchData()
  return (
    <div>
      <div>Count: {data.length}</div> {/* Server renders */}
      <ClientComponent /> {/* Client shows different */}
    </div>
  )
}

// ✅ GOOD - Let client own data
export default async function Page() {
  return (
    <Suspense fallback={<Skeleton />}>
      <ClientComponent />
    </Suspense>
  )
}
```

