## Backend: Elysia API

### Model (`model.ts`)

```typescript
import { z } from 'zod'

export const UserModel = {
  createPayload: z.object({
    name: z.string().min(1, 'Name is required'),
    email: z.string().email('Invalid email'),
    role: z.enum(['admin', 'user', 'viewer']),
  }),

  updatePayload: z.object({
    name: z.string().min(1).optional(),
    email: z.string().email().optional(),
    role: z.enum(['admin', 'user', 'viewer']).optional(),
  }),

  params: z.object({
    id: z.string().uuid(),
  }),

  queryParams: z.object({
    page: z.coerce.number().min(1).default(1),
    limit: z.coerce.number().min(1).max(100).default(20),
    status: z.enum(['active', 'inactive']).optional(),
  }),
}

export type CreateUserPayload = z.infer<typeof UserModel.createPayload>
export type UpdateUserPayload = z.infer<typeof UserModel.updatePayload>
export type UserQueryParams = z.infer<typeof UserModel.queryParams>
```

### Routes (`index.ts`)

```typescript
import { Elysia } from 'elysia'
import { authPlugin } from '../../plugins/auth'
import { auth } from '@sentinow/auth'
import { UserModel, type CreateUserPayload } from './model'

export const users = new Elysia({ prefix: '/users' })
  .onTransform(({ path, request: { method } }) => {
    console.log(`${method} ${path}`)
  })
  .use(authPlugin)
  
  // GET /users/list
  .get(
    '/list',
    async ({ query, request }) => {
      const users = await auth.api.listUsers({
        headers: request.headers,
        query,
      })
      return users
    },
    {
      auth: true,
      query: UserModel.queryParams,
    }
  )
  
  // GET /users/:id
  .get(
    '/:id',
    async ({ params, request }) => {
      const user = await auth.api.getUser({
        headers: request.headers,
        params,
      })
      return user
    },
    {
      auth: true,
      params: UserModel.params,
    }
  )
  
  // POST /users/create
  .post(
    '/create',
    async ({ body, request, set }) => {
      try {
        const user = await auth.api.createUser({
          headers: request.headers,
          body: body as CreateUserPayload,
        })
        return user
      } catch (err) {
        const errorMessage =
          err instanceof Error ? err.message : 'Failed to create user'

        if (errorMessage.includes('email') || errorMessage.includes('unique')) {
          set.status = 409
          return {
            message: 'A user with this email already exists',
            statusText: 'Conflict',
          }
        }

        set.status = 400
        return {
          message: errorMessage,
          statusText: 'Bad Request',
        }
      }
    },
    {
      auth: true,
      body: UserModel.createPayload,
    }
  )
  
  // PATCH /users/:id
  .patch(
    '/:id',
    async ({ params, body, request, set }) => {
      try {
        const user = await auth.api.updateUser({
          headers: request.headers,
          params,
          body,
        })
        return user
      } catch (err) {
        set.status = 400
        return {
          message: err instanceof Error ? err.message : 'Update failed',
          statusText: 'Bad Request',
        }
      }
    },
    {
      auth: true,
      params: UserModel.params,
      body: UserModel.updatePayload,
    }
  )
  
  // DELETE /users/:id
  .delete(
    '/:id',
    async ({ params, request, set }) => {
      try {
        await auth.api.deleteUser({
          headers: request.headers,
          params,
        })
        return { success: true }
      } catch (err) {
        set.status = 400
        return {
          message: err instanceof Error ? err.message : 'Delete failed',
          statusText: 'Bad Request',
        }
      }
    },
    {
      auth: true,
      params: UserModel.params,
    }
  )
```

