{
	"name": "lighthouse-poc",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^5"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:native": "turbo -F native dev",
		"dev:web": "turbo -F web dev",
		"build:web": "turbo -F web build",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@lighthouse-poc/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.15",
		"@lighthouse-poc/config": "workspace:*",
		"@types/node": "^25.2.3",
		"turbo": "^2.8.7",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.6"
}
